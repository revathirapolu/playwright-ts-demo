pipeline {
    agent any
 
    stages {
 
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
 
        stage('Setup Node') {
            steps {
                sh '''
                    export NVM_DIR="/Users/ramrapolu/.nvm"
                    . "$NVM_DIR/nvm.sh"
                    nvm use 22.23.1
 
                    echo "Node:"
                    node --version
 
                    echo "NPM:"
                    npm --version
                '''
            }
        }
 
        stage('Install Dependencies') {
            steps {
                sh '''
                    export NVM_DIR="/Users/ramrapolu/.nvm"
                    . "$NVM_DIR/nvm.sh"
                    nvm use 22.23.1
 
                    npm ci
                '''
            }
        }
 
        stage('Install Playwright Browsers') {
            steps {
                sh '''
                    export NVM_DIR="/Users/ramrapolu/.nvm"
                    . "$NVM_DIR/nvm.sh"
                    nvm use 22.23.1
 
                    npx playwright install
                '''
            }
        }
 
        stage('Run Playwright Tests') {
            steps {
                sh '''
                    export NVM_DIR="/Users/ramrapolu/.nvm"
                    . "$NVM_DIR/nvm.sh"
                    nvm use 22.23.1
 
                    npx playwright test
                '''
            }
        }
   }
    post {
      always {
           archiveArtifacts artifacts: 'playwright-report/**/*',
                            allowEmptyArchive: true
      }
  }
}

}
