pipeline {

    agent any
 
    stages {
 
        stage('Checkout') {

            steps {

                checkout scm

            }

        }
 
        stage('Check Environment') {

            steps {

                sh '''

                    echo "========== ENVIRONMENT =========="

                    echo "PATH=$PATH"

                    echo "JAVA_HOME=$JAVA_HOME"
 
                    echo "========== TOOLS =========="

                    echo "Node:"

                    which node || true

                    node --version || true
 
                    echo "NPM:"

                    which npm || true

                    npm --version || true
 
                    echo "Git:"

                    which git || true

                    git --version || true

                '''

            }

        }

    }

}
