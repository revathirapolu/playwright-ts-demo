pipeline {
    agent any
 
    stages {
 
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
 
        stage('Check Environment') {
            steps {
                sh '''
                    export NVM_DIR="/Users/ramrapolu/.nvm"
 
                    if [ -s "$NVM_DIR/nvm.sh" ]; then
                        . "$NVM_DIR/nvm.sh"
                    else
                        echo "NVM not found"
                        exit 1
                    fi
 
                    nvm use 22.23.1
 
                    echo "===== Node ====="
                    which node
                    node --version
 
                    echo "===== NPM ====="
                    which npm
                    npm --version
 
                    echo "===== Git ====="
                    which git
                    git --version
                '''
            }
        }
    }
}
